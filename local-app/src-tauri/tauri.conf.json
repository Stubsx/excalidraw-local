{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Local",
  "version": "0.1.0",
  "identifier": "com.excalidraw-local.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "Excalidraw Local",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 jabber1. Based on Excalidraw (MIT).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../cli/bin/excal.mjs": "cli/bin/excal.mjs",
      "../cli/commands/": "cli/commands/",
      "../cli/generators/": "cli/generators/",
      "../cli/lib/": "cli/lib/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "frameworks": [],
      "exceptionDomain": ""
    }
  }
}