{
  "name": "excalidraw-local",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Local-first Excalidraw desktop app with file management and Agent CLI",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --config vitest.config.ts",
    "test:cli": "node --test tests/cli*.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-sql": "^2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
