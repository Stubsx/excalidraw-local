#!/bin/sh
# post-commit — auto-rebuild Excalidraw Local after every commit.
#
# Mirrors the AIStatusBar reference workflow: kick off a background build that
#   1. rebuilds the .app + .dmg,
#   2. stages the dmg into dist-release/, and
#   3. restarts the locally-running app.
#
# Runs detached via nohup so `git commit` returns instantly; the build (Tauri
# release, 1–few min) and its output go to dist-release/build.log.
#
# Dedup: if a build is already running (PID lockfile), skip — rapid successive
# commits would otherwise stack multiple multi-minute builds.
#
# Skip on rebase/am/merge commits and when the hook is disabled:
#   HOOK_SKIP=1 git commit ...      # bypass
REPO_DIR="$(git rev-parse --show-toplevel)"
APP_DIR="$REPO_DIR/local-app"
BUILD_SCRIPT="$APP_DIR/scripts/build-dmg.sh"
LOG_DIR="$APP_DIR/dist-release"
LOCKFILE="$LOG_DIR/.build.lock"

# Only fire for plain commits — not rebases / cherry-picks / merges.
if [ -f "$REPO_DIR/.git/rebase-merge" ] || [ -f "$REPO_DIR/.git/rebase-apply" ]; then
  exit 0
fi
[ -n "${HOOK_SKIP:-}" ] && exit 0
[ -f "$BUILD_SCRIPT" ] || exit 0

# Dedup: if a previous build is still alive, bail out.
if [ -f "$LOCKFILE" ]; then
  OLD_PID="$(cat "$LOCKFILE" 2>/dev/null)"
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    # Still building the last commit — skip. The next commit after it finishes
    # picks up the latest state.
    exit 0
  fi
  # Stale lockfile (process died without cleanup) — reclaim below.
fi

mkdir -p "$LOG_DIR"
# Lockfile is written by build-dmg.sh itself (its own $$) and removed on exit
# via trap. We just launch the build here.
nohup bash "$BUILD_SCRIPT" > "$LOG_DIR/build.log" 2>&1 &
